# Datos sensibles: NO versionar.
# Reportes y JSON descargados de la Central de Deudores (datos personales/financieros).
out/
# Lista de CUILs reales (datos personales).
cuils.txt
# Planilla Impulso exportada (.xlsx) — PII de prestatarios. Guardala en out/.
*.xlsx
# Credenciales del service account de Google (clave privada). NUNCA versionar.
service_account*.json
credentials*.json
# Id de la planilla privada (identificador del recurso, fuera del código).
.impulso_file_id
# Id (opcional) de la carpeta de Drive con las fotos de DNI (fuera del código).
# Las fotos se bajan a out/dni/ — ya cubierto por out/ de arriba (PII).
.dni_folder_id
